# Copy to deploy/.env and initialize the registry with bin/tokens.php init.
# Legacy single-token mode: unset SECRETBOX_UPLOAD_TOKEN_FILE before setting this.
# Leave empty when using the registry.
SECRETBOX_UPLOAD_TOKEN=
SECRETBOX_UPLOAD_TOKEN_FILE=/var/lib/secretbox/config/server.json
SECRETBOX_STORAGE_DIR=/var/lib/secretbox
SECRETBOX_MAX_BYTES=104857600
SECRETBOX_MAX_TOTAL_BYTES=1073741824
SECRETBOX_MAX_TRANSFERS=1000
SECRETBOX_TTL_SECONDS=86400
SECRETBOX_DOMAIN=:8080
